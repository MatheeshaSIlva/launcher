<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- T-001 2b's shell proof calls the launcher's handover provider from this APK's uid (package visibility). -->
    <queries>
        <provider android:authorities="dev.launcher.app.shell" />
    </queries>
    <application>
        <!-- T-005's attached icon reveal (IconRevealProof): an empty window of the test APK's own. -->
        <activity android:name="dev.launcher.engine.ui.ProofActivity" android:exported="false" />
    </application>
</manifest>
