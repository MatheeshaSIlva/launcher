// The status bar as a component (docs/E2_PLAN.md; slices 6, 10, 12). Its numbers are StatusBarView's
// (SIDE_PT 34, TIME_PT 15, Fonts.text(600), 'tnum'); they become comp.statusbar.* tokens with the rest (B-114).
// Everything but motion: a level or a slot changes by a cut until slice 13.
// The window places the row's centre line on the camera's (StatusBarView's centreLine), and gives:
//   hour24     the phone's 24-hour setting (H:mm or h:mm, no AM/PM, as StatusBarView)
//   color      the bar's content colour for its tone (white or black)
//   max-icons  how many notification icons fit before the camera (BarFit), worked out with each change of the time's width
component "status-bar" version="0.1.0" {
  props {
    hour24 type=bool default=#true
    color type=color default="#FFFFFF"
    max-icons type=number default=3
  }
  uses {
    source time
    source battery
    source network
    source dnd
    source notifications
  }
  view {
    row padding-start=34 padding-end=34 align="centre-line" label="Status bar" {
      text "{@hour24 ? (now | date:'H:mm') : (now | date:'h:mm')}" size=15 weight=600 tnum=#true color="@color" label="Time"
      spacer size=7
      row gap=4.5 align="centre-line" label="Notifications" {
        icon "moon" set="statusbar" size=12.4 color="@color" visible="{dnd.on}" label="Do Not Disturb"
        icon each="{take(notifications.icons, @max-icons)}" as="n" picture="{n.id}" rev="{n.rev}" size=14.5 color="@color"
        box width=3.4 height=3.4 radius=1.7 fill="@color" visible="{length(notifications.icons) > @max-icons}"
      }
      spacer flex=1
      row gap=6.8 align="centre-line" label="Status" {
        icon "airplane" set="statusbar" size=16.8 color="@color" visible="{network.service == 'airplane'}"
        text "No SIM" size=13.5 weight=600 color="@color" visible="{network.service == 'no-sim'}"
        text "No Service" size=13.5 weight=600 color="@color" visible="{network.service == 'no-service'}"
        icon "cell.{network.cell.level}" set="statusbar" size=18.6 color="@color" visible="{network.service == 'in-service'}"
        text "{network.type}" size=12.5 weight=600 color="@color" visible="{!network.wifi.connected && network.type != '' && network.service == 'in-service'}"
        icon "wifi.{network.wifi.level}" set="statusbar" size=17 color="@color" visible="{network.wifi.connected}"
        box height=12 radius=3 padding-start=2.5 padding-end=2.5 stroke=1.2 stroke-color="@color" stroke-align="center" align="centre-line" visible="{network.vpn}" label="VPN" {
          text "VPN" size=9.5 weight=600 color="@color"
        }
        // StatusBarView's drawBattery at rest: the faint body, the same body filled to the level, the number cut out of both,
        // the faint nub. The level's colour: the content's, toward low from 25 % to 17 %, then Low Power, then charging,
        // with the content's alpha. (Their glides are motion: slice 13.)
        row gap=2.6 align="centre-line" label="Battery and charging" {
          row gap=0.8 align="centre-line" label="Battery" {
            stack width=24.6 height=12.6 align="centre-line" layer=#true {
              box width=24.6 height=12.6 radius=4.2 fill="{scaleAlpha(@color, 89, 255)}"
              box width=24.6 height=12.6 radius=4.2 reveal="{clamp(battery.level / 100, 0, 1)}" fill="{withAlpha(mix(mix(mix(opaque(@color), @comp.statusbar.battery-low-color, clamp((25 - battery.level) / 8, 0, 1)), @comp.statusbar.battery-saver-color, battery.power-save ? 1 : 0), @comp.statusbar.battery-charging-color, battery.charging ? 1 : 0), alphaOf(@color))}"
              text "{battery.level}" width=24.6 size=9.6 weight=700 tnum=#true align="center" blend="knockout"
            }
            box width=1.6 height=4.4 radius=1.6 fill="{scaleAlpha(@color, 102, 255)}"
          }
          icon "bolt" set="statusbar" size=9 color="@color" visible="{battery.charging}"
        }
      }
    }
  }
}
