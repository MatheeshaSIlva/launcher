// Draft 4's island at rest (T-012). Literal design values until the default theme supplies tokens.
// Fixed dp text does not follow system font size in this slice. The real camera needs no artwork;
// without a cutout the centre stays empty too (owner, 2026-11-12). Never nearer the screen's top than 4 dp (draft 4 said 8;
// the owner moved it up to centre the S24's camera and fit Android's 103 px bar, 2026-11-12).
// Pure black, not the design language's #0A0A0A: on an OLED screen a lit #0A0A0A shows the camera through it (owner, S24,
// 2026-11-12).
// Media (T-013): while something plays the island widens to draft 4's 236 dp (Figma node 41:276): the cover and title
// left of the camera, five terracotta bars right of it, in fixed slots (14 | 90 | 28 | 92 | 12) so the camera slot stays
// on the pill's centre whatever the title. A pause goes back at once (owner). The bars loop while it plays (owner: a
// made-up rhythm, no permission); a long title fades at its end and scrolls slowly, `title-scroll` off stops the scroll
// (owner, 2026-11-12). Both states are centred on the camera and clipped to the pill, which reveals them as it moves.
// Arrivals (T-014): one state at a time by rank, a notification over charging over media over idle, the lower coming back
// after. Charging (Figma 8:195): 164 dp, the time left of the camera, the level and a bolt in `ok` green right of it, for
// the plug-in moment (`battery.plugged`, 3 s). A notification (Figma 8:203, the minimal mode): 200 dp, a terracotta dot and
// the sender left, "+N" in `muted` grey right, for 4 s (`notifications.arrival`; the app's name instead of the sender
// while locked). `mode` "detailed" (a banner that grows out of the island) comes with E2.14c-2 and shows as minimal now.
component "island" version="0.3.0" {
  props {
    hour24 type=bool default=#true
    title-scroll type=bool default=#true
    mode type=string default="minimal"
  }
  uses {
    source device
    source time
    source battery
    source media
    source notifications
  }
  view {
    // The pill opens on a soft spring (a slight overshoot); the time leaves at once and the pieces come in a beat apart,
    // the cover, the title, then the bars. Closing, the pieces go together and the time comes back once they have gone
    // (owner, 2026-11-12: "springy and staged").
    // Every piece has a fixed slot that stays, so nothing shifts while the others come and go.
    box place="cutout" place-gap=(dp)4 width="{notifications.arriving ? 200dp : (battery.plugged ? 164dp : (media.playing ? 236dp : 132dp))}" height=(dp)32 radius="full" fill="#000000" align="centre" clip=#true transition="size spring(0.45, 0.75)" label="Island" {
      row width=(dp)132 padding-start=(dp)14 padding-end=(dp)12 align="centre-line" visible="{!notifications.arriving && !battery.plugged && !media.playing}" enter="fade spring(0.45, 1) delay(110ms)" exit="fade 90ms" label="Idle" {
        text "{@hour24 ? (now | date:'H:mm') : (now | date:'h:mm')}" font="jetbrains-mono" size=(dp)13 weight=400 color="#F2F2F2" roll=#true label="Time"
        spacer flex=1
        text "{battery.level}" font="jetbrains-mono" size=(dp)13 weight=400 color="#F2F2F2" roll=#true label="Battery"
      }
      row width=(dp)236 padding-start=(dp)14 padding-end=(dp)12 align="centre-line" label="Media" {
        row width=(dp)90 gap=(dp)6 align="centre-line" label="Left" {
          box width=(dp)20 height=(dp)20 align="centre" label="Cover slot" {
            image picture="{media.art}" size=(dp)20 radius=(dp)4 visible="{media.playing && !notifications.arriving && !battery.plugged && media.has-art}" enter="fade scale spring(0.38, 0.72) delay(70ms)" exit="fade scale 100ms" label="Cover"
          }
          box width=(dp)64 height=(dp)20 align="centre-line" label="Title slot" {
            text "{media.title}" font="plex-sans" size=(dp)13 weight=400 color="#F2F2F2" width=(dp)64 overflow="fade" fade=(dp)12 scroll="{@title-scroll && media.playing}" visible="{media.playing && !notifications.arriving && !battery.plugged}" enter="fade rise spring(0.5, 0.85) delay(120ms)" exit="fade 100ms" label="Title"
          }
        }
        spacer size=(dp)28
        row width=(dp)92 align="centre-line" label="Right" {
          spacer flex=1
          row gap=(dp)2 align="centre-line" visible="{media.playing && !notifications.arriving && !battery.plugged}" enter="fade scale spring(0.55, 0.8) delay(170ms)" exit="fade 100ms" label="Bars" {
            box width=(dp)2 height=(dp)6 radius=(dp)1 fill="#D9865F" loop-from=(dp)4 loop-to=(dp)10 loop-period=760 loop-phase=0.10 loop-run="{media.playing}"
            box width=(dp)2 height=(dp)12 radius=(dp)1 fill="#D9865F" loop-from=(dp)6 loop-to=(dp)14 loop-period=980 loop-phase=0.55 loop-run="{media.playing}"
            box width=(dp)2 height=(dp)8 radius=(dp)1 fill="#D9865F" loop-from=(dp)4 loop-to=(dp)12 loop-period=640 loop-phase=0.30 loop-run="{media.playing}"
            box width=(dp)2 height=(dp)14 radius=(dp)1 fill="#D9865F" loop-from=(dp)6 loop-to=(dp)14 loop-period=1120 loop-phase=0.80 loop-run="{media.playing}"
            box width=(dp)2 height=(dp)10 radius=(dp)1 fill="#D9865F" loop-from=(dp)4 loop-to=(dp)12 loop-period=860 loop-phase=0.45 loop-run="{media.playing}"
          }
        }
      }
      // Charging: 14 | 54 | 28 | 56 | 12 (164 dp), the camera slot on the pill's centre.
      row width=(dp)164 padding-start=(dp)14 padding-end=(dp)12 align="centre-line" label="Charging" {
        box width=(dp)54 height=(dp)20 align="centre-line" label="Charging left" {
          text "{@hour24 ? (now | date:'H:mm') : (now | date:'h:mm')}" font="jetbrains-mono" size=(dp)13 weight=400 color="#F2F2F2" roll=#true visible="{battery.plugged && !notifications.arriving}" enter="fade spring(0.45, 0.9) delay(70ms)" exit="fade 90ms" label="Charging time"
        }
        spacer size=(dp)28
        row width=(dp)56 align="centre-line" label="Charging right" {
          spacer flex=1
          row gap=(dp)6 align="centre-line" visible="{battery.plugged && !notifications.arriving}" enter="fade scale spring(0.5, 0.75) delay(120ms)" exit="fade 90ms" label="Level" {
            text "{battery.level}%" font="jetbrains-mono" size=(dp)13 weight=400 color="#7DBE93" roll=#true label="Charging level"
            text "↯" font="jetbrains-mono" size=(dp)13 weight=400 color="#7DBE93" label="Bolt"
          }
        }
      }
      // A notification, minimal: 14 | 72 | 28 | 74 | 12 (200 dp).
      row width=(dp)200 padding-start=(dp)14 padding-end=(dp)12 align="centre-line" label="Notification" {
        row width=(dp)72 gap=(dp)6 align="centre-line" label="Notification left" {
          box width=(dp)6 height=(dp)6 align="centre" label="Dot slot" {
            box width=(dp)6 height=(dp)6 radius="full" fill="#D9865F" visible="{notifications.arriving}" enter="fade scale spring(0.4, 0.7) delay(70ms)" exit="fade 90ms" label="Dot"
          }
          box width=(dp)60 height=(dp)20 align="centre-line" label="Sender slot" {
            text "{notifications.arrival.name}" font="plex-sans" size=(dp)13 weight=400 color="#F2F2F2" width=(dp)60 overflow="fade" fade=(dp)10 visible="{notifications.arriving}" enter="fade rise spring(0.5, 0.85) delay(110ms)" exit="fade 90ms" label="Sender"
          }
        }
        spacer size=(dp)28
        row width=(dp)74 align="centre-line" label="Notification right" {
          spacer flex=1
          text "+{notifications.arrival.others}" font="jetbrains-mono" size=(dp)13 weight=400 color="#8A8A8A" visible="{notifications.arriving && notifications.arrival.others > 0}" enter="fade spring(0.5, 0.9) delay(150ms)" exit="fade 90ms" label="Others"
        }
      }
    }
  }
}
