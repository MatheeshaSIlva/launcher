// Draft 4's island at rest (T-012). Literal design values until the default theme supplies tokens.
// Fixed dp text does not follow system font size in this slice. The real camera needs no artwork;
// without a cutout the centre stays empty too (owner, 2026-11-12). Never nearer the screen's top than 4 dp (draft 4 said 8;
// the owner moved it up to centre the S24's camera and fit Android's 103 px bar, 2026-11-12).
// Pure black, not the design language's #0A0A0A: on an OLED screen a lit #0A0A0A shows the camera through it (owner, S24,
// 2026-11-12).
// Media (T-013): while something plays the island widens to draft 4's 236 dp (Figma node 41:276): the cover and title
// left of the camera, five terracotta bars right of it, in fixed slots (14 | 90 | 28 | 92 | 12) so the camera slot stays
// on the pill's centre whatever the title. A pause goes back at once (owner). The bars loop while it plays (owner: a
// made-up rhythm, no permission); a long title fades at its end and scrolls slowly, `title-scroll` off stops the scroll
// (owner, 2026-11-12). Both states are centred on the camera and clipped to the pill, which reveals them as it moves.
// Arrivals (T-014): one state at a time by rank, a notification over charging over media over idle, the lower coming back
// after. Charging (Figma 8:195): 164 dp, the time left of the camera, the level and a bolt in `ok` green right of it, for
// the plug-in moment (`battery.plugged`, 3 s). A notification (Figma 8:203, the minimal mode): 200 dp, a terracotta dot and
// the sender left, "+N" in `muted` grey right, for 4 s (`notifications.arrival`; the app's name instead of the sender
// while locked). `mode` "detailed" (a banner that grows out of the island) comes with E2.14c-2 and shows as minimal now.
// The island comes and goes with the bar (E2.14e): an app that goes full screen hides it (a quick fade and shrink), a
// swipe from the top shows it for a moment (a soft spring back), as the stock bar does.
component "island" version="0.7.0" {
  props {
    hour24 type=bool default=#true
    title-scroll type=bool default=#true
    mode type=string default="minimal"
    shown type=bool default=#true
  }
  uses {
    source device
    source time
    source battery
    source media
    source notifications
  }
  view {
    // The pill opens on a soft spring (a slight overshoot); the time leaves at once and the pieces come in a beat apart,
    // the cover, the title, then the bars. Closing, the pieces go together and the time comes back once they have gone
    // (owner, 2026-11-12: "springy and staged").
    // Every piece has a fixed slot that stays, so nothing shifts while the others come and go.
    blob place="cutout" place-gap=(dp)4 width=(dp)132 height=(dp)32 fill="#000000" smooth=(dp)16 align="top" elastic=#true visible="{@shown}" enter="fade scale spring(0.4, 0.8)" exit="fade scale 160ms" label="Island" {
      box width="{(notifications.arriving && @mode != 'detailed') ? 200dp : (battery.plugged ? 164dp : (media.playing ? 236dp : 132dp))}" height=(dp)32 radius="full" fill="#000000" align="centre" clip=#true transition="size spring(0.45, 0.75)" label="Pill" {
        row width=(dp)132 padding-start=(dp)14 padding-end=(dp)12 align="centre-line" visible="{!(notifications.arriving && @mode != 'detailed') && !battery.plugged && !media.playing}" enter="fade spring(0.45, 1) delay(110ms)" exit="fade 90ms" label="Idle" {
          text "{@hour24 ? (now | date:'H:mm') : (now | date:'h:mm')}" font="jetbrains-mono" size=(dp)13 weight=400 color="#F2F2F2" roll=#true label="Time"
          spacer flex=1
          text "{battery.level}" font="jetbrains-mono" size=(dp)13 weight=400 color="#F2F2F2" roll=#true label="Battery"
        }
        row width=(dp)236 padding-start=(dp)14 padding-end=(dp)12 align="centre-line" label="Media" {
          row width=(dp)90 gap=(dp)6 align="centre-line" label="Left" {
            box width=(dp)20 height=(dp)20 align="centre" label="Cover slot" {
              image picture="{media.art}" size=(dp)20 radius=(dp)4 visible="{media.playing && !(notifications.arriving && @mode != 'detailed') && !battery.plugged && media.has-art}" enter="fade scale spring(0.38, 0.72) delay(70ms)" exit="fade scale 100ms" label="Cover"
            }
            box width=(dp)64 height=(dp)20 align="centre-line" label="Title slot" {
              text "{media.title}" font="plex-sans" size=(dp)13 weight=400 color="#F2F2F2" width=(dp)64 overflow="fade" fade=(dp)12 scroll="{@title-scroll && media.playing}" visible="{media.playing && !(notifications.arriving && @mode != 'detailed') && !battery.plugged}" enter="fade rise spring(0.5, 0.85) delay(120ms)" exit="fade 100ms" label="Title"
            }
          }
          spacer size=(dp)28
          row width=(dp)92 align="centre-line" label="Right" {
            spacer flex=1
            row gap=(dp)2 align="centre-line" visible="{media.playing && !(notifications.arriving && @mode != 'detailed') && !battery.plugged}" enter="fade scale spring(0.55, 0.8) delay(170ms)" exit="fade 100ms" label="Bars" {
              box width=(dp)2 height=(dp)6 radius=(dp)1 fill="#D9865F" loop-from=(dp)4 loop-to=(dp)10 loop-period=760 loop-phase=0.10 loop-run="{media.playing}"
              box width=(dp)2 height=(dp)12 radius=(dp)1 fill="#D9865F" loop-from=(dp)6 loop-to=(dp)14 loop-period=980 loop-phase=0.55 loop-run="{media.playing}"
              box width=(dp)2 height=(dp)8 radius=(dp)1 fill="#D9865F" loop-from=(dp)4 loop-to=(dp)12 loop-period=640 loop-phase=0.30 loop-run="{media.playing}"
              box width=(dp)2 height=(dp)14 radius=(dp)1 fill="#D9865F" loop-from=(dp)6 loop-to=(dp)14 loop-period=1120 loop-phase=0.80 loop-run="{media.playing}"
              box width=(dp)2 height=(dp)10 radius=(dp)1 fill="#D9865F" loop-from=(dp)4 loop-to=(dp)12 loop-period=860 loop-phase=0.45 loop-run="{media.playing}"
            }
          }
        }
        // Charging: 14 | 54 | 28 | 56 | 12 (164 dp), the camera slot on the pill's centre.
        row width=(dp)164 padding-start=(dp)14 padding-end=(dp)12 align="centre-line" label="Charging" {
          box width=(dp)54 height=(dp)20 align="centre-line" label="Charging left" {
            text "{@hour24 ? (now | date:'H:mm') : (now | date:'h:mm')}" font="jetbrains-mono" size=(dp)13 weight=400 color="#F2F2F2" roll=#true visible="{battery.plugged && !(notifications.arriving && @mode != 'detailed')}" enter="fade spring(0.45, 0.9) delay(70ms)" exit="fade 90ms" label="Charging time"
          }
          spacer size=(dp)28
          row width=(dp)56 align="centre-line" label="Charging right" {
            spacer flex=1
            row gap=(dp)6 align="centre-line" visible="{battery.plugged && !(notifications.arriving && @mode != 'detailed')}" enter="fade scale spring(0.5, 0.75) delay(120ms)" exit="fade 90ms" label="Level" {
              text "{battery.level}%" font="jetbrains-mono" size=(dp)13 weight=400 color="#7DBE93" roll=#true label="Charging level"
              text "↯" font="jetbrains-mono" size=(dp)13 weight=400 color="#7DBE93" label="Bolt"
            }
          }
        }
        // A notification, minimal: 14 | 72 | 28 | 74 | 12 (200 dp).
        row width=(dp)200 padding-start=(dp)14 padding-end=(dp)12 align="centre-line" label="Notification" {
          row width=(dp)72 gap=(dp)6 align="centre-line" label="Notification left" {
            box width=(dp)6 height=(dp)6 align="centre" label="Dot slot" {
              box width=(dp)6 height=(dp)6 radius="full" fill="#D9865F" visible="{(notifications.arriving && @mode != 'detailed')}" enter="fade scale spring(0.4, 0.7) delay(70ms)" exit="fade 90ms" label="Dot"
            }
            box width=(dp)60 height=(dp)20 align="centre-line" label="Sender slot" {
              text "{notifications.arrival.name}" font="plex-sans" size=(dp)13 weight=400 color="#F2F2F2" width=(dp)60 overflow="fade" fade=(dp)10 visible="{(notifications.arriving && @mode != 'detailed')}" enter="fade rise spring(0.5, 0.85) delay(110ms)" exit="fade 90ms" label="Sender"
            }
          }
          spacer size=(dp)28
          row width=(dp)74 align="centre-line" label="Notification right" {
            spacer flex=1
            text "+{notifications.arrival.others}" font="jetbrains-mono" size=(dp)13 weight=400 color="#8A8A8A" visible="{(notifications.arriving && @mode != 'detailed') && notifications.arrival.others > 0}" enter="fade spring(0.5, 0.9) delay(150ms)" exit="fade 90ms" label="Others"
          }
        }
      }
      // The detailed notification (T-015; owner, 2026-11-13: "it should work exactly like a fluid would"): a second shape
      // that rests at no size inside the pill, 12 dp down (an empty shape takes no part in the union; two on one place
      // would swell it by a quarter of `smooth`). On an arrival it fills like a droplet: the pill swells as one body,
      // wider and longer (the size grows from the start, the drop barely moving), then gets heavy and sinks (a curve
      // that starts slowly and then lets go). The blob is elastic: the pill stretches toward the drop and the neck holds
      // and thins (tension) until it breaks, about 0.5 s in, the drop three quarters grown; both snap back past their
      // rest (squash) and settle while the drop grows the rest of the way into the banner. Then its content comes in,
      // sliding and out of a blur. Going back plays it the other way. The banner is the design language's glass tint
      // (#121212 at 76 %) with shadow-float and a hairline from the blob; the solid pill and the glass banner blend
      // across the neck. Text on it: ink and ink-2 only.
      box width="{(notifications.arriving && @mode == 'detailed') ? 380dp : 0dp}" height="{(notifications.arriving && @mode == 'detailed') ? 76dp : 0dp}" radius="{(notifications.arriving && @mode == 'detailed') ? 26dp : 0dp}" translate-y="{(notifications.arriving && @mode == 'detailed') ? 60dp : 12dp}" fill="#C2121212" transition="size cubic-bezier(0.35, 0.3, 0.45, 1) 950ms, radius spring(0.38, 0.85), place cubic-bezier(0.8, 0, 0.25, 1) 700ms" label="Banner" {
        box width=(dp)36 height=(dp)36 radius="full" fill="#1FFFFFFF" translate-x=(dp)16 translate-y=(dp)20 visible="{(notifications.arriving && @mode == 'detailed')}" enter="fade slide blur spring(0.5, 0.88) delay(620ms)" exit="fade blur 120ms" label="Mark" {
          text "{notifications.arrival.mark}" font="plex-sans" size=(dp)15 weight=500 color="#F2F2F2" translate-x=(dp)13 translate-y=(dp)8 label="Mark letter"
        }
        text "{notifications.arrival.name}" font="plex-sans" size=(dp)14 weight=500 color="#F2F2F2" width=(dp)250 overflow="fade" fade=(dp)12 translate-x=(dp)64 translate-y=(dp)16 visible="{(notifications.arriving && @mode == 'detailed')}" enter="fade slide blur spring(0.5, 0.88) delay(650ms)" exit="fade blur 120ms" label="Banner sender"
        text "{notifications.arrival.text}" font="plex-sans" size=(dp)13 weight=400 color="#C4C4C4" width=(dp)280 overflow="fade" fade=(dp)12 translate-x=(dp)64 translate-y=(dp)38 visible="{(notifications.arriving && @mode == 'detailed')}" enter="fade slide blur spring(0.5, 0.88) delay(690ms)" exit="fade blur 120ms" label="Banner text"
        text "now" font="jetbrains-mono" size=(dp)11 weight=400 color="#C4C4C4" translate-x=(dp)336 translate-y=(dp)18 visible="{(notifications.arriving && @mode == 'detailed')}" enter="fade blur spring(0.5, 0.9) delay(690ms)" exit="fade blur 120ms" label="Banner time"
      }
    }
  }
}
