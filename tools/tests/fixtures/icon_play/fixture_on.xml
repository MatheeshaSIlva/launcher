<objectAnimator android:duration="400" android:startOffset="0" android:propertyXName="translateX" android:propertyYName="translateY" android:pathData="M0,0 L10,0 C10,5 5,10 0,10" android:propertyName="translateXY">
<aapt:attr name="android:interpolator"><linearInterpolator>
</linearInterpolator></aapt:attr></objectAnimator>
</set></aapt:attr></target>
