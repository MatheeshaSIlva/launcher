<!-- A small animated vector in the form tools/icons/extract_apk_vectors.py writes (interpolators inline), for
     tools/tests/icon_play_test.sh: a group turned and moved along a motion path by two entries (overshoot), a morph
     (relative commands in its first look, no interpolator: the default), a bar whose stroke grows and whose trim runs
     (linear, delayed), a path faded on an interpolator given as path data, a group that rests at scale 0 and grows in after a delay. -->
<animated-vector xmlns:aapt="http://schemas.android.com/aapt" xmlns:android="http://schemas.android.com/apk/res/android">
<target android:name="turn">
