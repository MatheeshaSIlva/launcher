<aapt:attr name="android:interpolator"><pathInterpolator android:controlX1="0.26" android:controlY1="1.5" android:controlX2="0.27" android:controlY2="1">
</pathInterpolator></aapt:attr></objectAnimator>
</set></aapt:attr></target>
<target android:name="turn">
