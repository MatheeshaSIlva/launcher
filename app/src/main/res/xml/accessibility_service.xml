<?xml version="1.0" encoding="utf-8"?>
<!-- Used for TYPE_ACCESSIBILITY_OVERLAY windows (not hidden by Settings or setHideOverlayWindows), and for which app is in
     front and when its screen changed (only the package of an event is read; no window content). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewScrolled"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/a11y_description"
    android:notificationTimeout="0" />
