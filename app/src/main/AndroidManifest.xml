<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The updater asks GitHub which build is newest from the app process; the APK itself downloads in the shell process. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Our status bar: Wi-Fi state (normal permission) and the mobile network type (granted through Shizuku). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Control Center's Timer: starts a timer in the clock app without opening it (AlarmClock.ACTION_SET_TIMER). -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Our shade's notification icons come from apps that are not always launchable (system packages); a launcher may
         see every package. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Gesture strip and card windows (TYPE_APPLICATION_OVERLAY); granted through Shizuku (appops). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Not granted at install. Declared so the shell can grant it once (pm grant); then animation scales can be
         restored without Shizuku. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Reading the wallpaper bitmap (for glass that refracts it) needs all-files access on Android 13+; granted via
         Shizuku appops. Play policy: to be justified or replaced before a store build. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- A launcher must see every launchable app (icons, labels, launch intents). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Apps' Quick Settings tiles: Control Center offers them as controls (shade/AppTiles.kt). -->
        <intent>
            <action android:name="android.service.quicksettings.action.QS_TILE" />
        </intent>
        <!-- Keyboards: their windows are told apart from the app in front (gesture navigation). -->
        <intent>
            <action android:name="android.view.InputMethod" />
        </intent>
    </queries>

    <application
        android:name=".LauncherApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Also listed in the app drawer, so it can be opened before it is the default home app. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Developer panel (status, updater, tests, log), opened from the home screen. -->
        <activity
            android:name=".DevActivity"
            android:exported="false"
            android:icon="@mipmap/ic_dev"
            android:label="Launcher dev" />

        <!-- The token editor (design system, docs/DESIGN_SYSTEM_PLAN.md): own task and own app-drawer entry. -->
        <activity
            android:name=".design.DesignActivity"
            android:exported="true"
            android:icon="@mipmap/ic_dev"
            android:label="Launcher design"
            android:launchMode="singleTask"
            android:taskAffinity="dev.launcher.app.design"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Notification counts for the icon badges (access granted through Shizuku, or in Settings). -->
        <service
            android:name=".BadgeListener"
            android:exported="true"
            android:label="Launcher badges"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Invisible, over the lock screen: asks the system to unlock before the shade opens an app (Unlock.kt). -->
        <activity
            android:name=".UnlockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:taskAffinity="dev.launcher.app.unlock"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Component previews for visual checks (adb shell am start -n dev.launcher.app/.PreviewActivity). Shows UI only. -->
        <activity
            android:name=".PreviewActivity"
            android:exported="true"
            android:label="Launcher preview"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <!-- Fixed recovery screen: own task and own app-drawer entry, so it opens even if the home screen is broken. -->
        <activity
            android:name=".SafeSettingsActivity"
            android:exported="true"
            android:icon="@mipmap/ic_safe"
            android:label="Launcher safe settings"
            android:launchMode="singleTask"
            android:taskAffinity="dev.launcher.app.safe"
            android:theme="@android:style/Theme.DeviceDefault.DayNight">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".RestoreReceiver"
            android:exported="false" />

        <receiver
            android:name=".GestureToggleReceiver"
            android:exported="false" />

        <!-- Only for its overlay window type (see NavAccessibilityService). -->
        <service
            android:name=".NavAccessibilityService"
            android:exported="true"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <!-- Keeps the process running so the watchdog heartbeat never stops while the launcher is alive. -->
        <service
            android:name=".WatchdogService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Safety watchdog heartbeat: restores the system status bar and animations if the launcher stops." />
        </service>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
