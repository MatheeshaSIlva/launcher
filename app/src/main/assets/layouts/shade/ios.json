{
 "format": 1,
 "element": "shade",
 "id": "ios",
 "title": "iOS",
 "origin": "iOS 27",
 "description": "Notification Center and Control Center as two panels.",
 "src": "iOS 27, measured in the Simulator and Apple's UI kit: docs/IOS27_KIT.md, docs/IOS27_EVALUATION.md",
 "placements": [
  {
   "id": "split-top",
   "title": "Notifications on the left",
   "description": "Pull down left of the camera for notifications, right of it for Control Center.",
   "pulls": [
    {"from": "left-of-camera", "panel": "notification-center"},
    {"from": "right-of-camera", "panel": "control-center"}
   ]
  },
  {
   "id": "split-top-mirrored",
   "title": "Control Center on the left",
   "description": "Pull down left of the camera for Control Center, right of it for notifications.",
   "pulls": [
    {"from": "left-of-camera", "panel": "control-center"},
    {"from": "right-of-camera", "panel": "notification-center"}
   ]
  }
 ],
 "options": [
  {
   "key": "cc-columns",
   "kind": "count",
   "title": "Control columns",
   "description": "Controls across Control Center.",
   "default": 4,
   "min": 4,
   "max": 6
  }
 ],
 "structure": {
  "panels": [
   {
    "panel": "notification-center",
    "blocks": [
     {"block": "lock-clock"},
     {"block": "notifications", "opens": "stacked"},
     {"block": "corner-buttons"}
    ],
    "landscape": "clock-beside-list"
   },
   {
    "panel": "control-center",
    "blocks": [
     {"block": "top-buttons"},
     {"block": "status-row"},
     {"block": "control-grid", "columns": {"option": "cc-columns"}, "editor": "in-place"}
    ],
    "landscape": "flow"
   }
  ]
 }
}
